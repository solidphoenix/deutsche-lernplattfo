# Frontend
VITE_API_BASE_URL=/api

# Backend
NODE_ENV=production
PORT=3001
APP_BASE_URL=https://example.com
ALLOWED_ORIGIN=https://example.com
FRONTEND_DIST_DIR=/app/dist
FALLBEISPIELE_DIR=/app/src/assets/documents
KNOWLEDGE_DIR=/app/knowledge
DB_PATH=/app/backend/data/sqlite/app.sqlite
VECTOR_DB_PATH=/app/backend/data/vector/knowledge.sqlite

# Generation provider
# Recommended public setup: keep LLM_PROVIDER=openai-compatible for a small VM
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-provider-api-key
LLM_MODEL=gpt-4.1-mini

# Ollama (optional for fully self-hosted generation)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings
# Runtime default is Ollama + nomic-embed-text.
# For a smaller public VM you can switch to openai-compatible if your provider supports embeddings.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text

# Public reverse proxy domain used by Caddy
APP_DOMAIN=example.com
